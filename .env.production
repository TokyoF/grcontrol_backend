# ===================================
# PRODUCTION ENVIRONMENT
# ===================================
# IMPORTANTE: Reemplazar con valores reales de producción

SPRING_DATASOURCE_URL=jdbc:postgresql://tu-db-host:5432/grcontrol_db
SPRING_DATASOURCE_USERNAME=tu_usuario_prod
SPRING_DATASOURCE_PASSWORD=tu_password_seguro_prod

# JWT Secret - GENERAR UNO NUEVO PARA PRODUCCIÓN
JWT_SECRET=CAMBIAR_ESTE_SECRET_POR_UNO_SEGURO_EN_PRODUCCION
JWT_EXPIRATION=86400000

# CORS - Solo dominios de producción (SIN http://localhost)
CORS_ALLOWED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com,https://app.tu-dominio.com

SERVER_PORT=8080

# Hibernate DDL - NUNCA usar create-drop en producción
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
